# BitTabby configuration
#
# DEPLOY-06: every value is supplied by the environment or by a file the
# environment points at. Nothing sensitive is committed. Any BITT_* value may
# use the form "file:/run/secrets/name" to read from a mounted file instead.

# Listen address
BITT_ADDR=:8080

# Storage backend: "sqlite" (default) or "mariadb". See docs/DEPLOY.md.
BITT_DB_DRIVER=sqlite

# SQLite database file (BITT_DB_DRIVER=sqlite). The parent directory is created
# with owner-only permissions, and the database files are chmod 0600 on open.
BITT_DB_PATH=data/bitt.db

# MariaDB connection string (BITT_DB_DRIVER=mariadb). Carries a password, so
# prefer the file: form. Format: user:pass@tcp(host:3306)/dbname
# BITT_DB_DSN=file:/run/secrets/db_dsn

# Instance-wide timezone, used for every period boundary. Seeds the first-run
# setup screen; after setup the value stored in the database is authoritative.
BITT_TIMEZONE=America/New_York

# Set to false ONLY for local plain-HTTP development. Leaving this false on a
# networked deployment sends session cookies without the Secure flag.
BITT_SECURE_COOKIES=true

# LEDGER-01 append-only database triggers. Disable only for development or a
# deliberate manual repair; the server logs a warning when they are off.
BITT_LEDGER_TRIGGERS=true

# Request timeouts
BITT_READ_TIMEOUT=15s
BITT_WRITE_TIMEOUT=30s
BITT_SHUTDOWN_TIMEOUT=15s

# ---------------------------------------------------------------------------
# Notifications (Phase 5)
#
# Nothing sends until an external caller hits /internal/tick with the secret
# below. There is no timer inside the server. See docs/DEPLOY.md.
#
# The server, port, username, from address, and ntfy URL can also be set in the
# app, under Notifications (administrators only) -- but a value set HERE WINS
# over one set there, so leave a setting unset if you want to manage it in the
# app. Credentials are the exception: they are environment-only and have no
# field in the app at all.
# ---------------------------------------------------------------------------

# Authenticates the cron caller to POST /internal/tick. UNSET MEANS THE ENDPOINT
# REFUSES EVERY REQUEST -- it fails closed, and no reminder can be delivered.
#   head -c 32 /dev/urandom | base64
BITT_TICK_SECRET=file:/run/secrets/tick_secret

# The external origin, used to build the link inside a reminder. It is
# deliberately not taken from a request Host header: the only caller that needs
# it arrives on a cron request whose Host is whatever the cron sent, and a link
# built from that is a phishing vector. Unset means reminders omit the link.
BITT_BASE_URL=https://bitt.example.com

# Email delivery. Unset BITT_SMTP_HOST turns email off.
# BITT_SMTP_HOST=smtp.example.com
# BITT_SMTP_PORT=587
# BITT_SMTP_USERNAME=bitt@example.com
# BITT_SMTP_PASSWORD=file:/run/secrets/smtp_password
# BITT_EMAIL_FROM=BitTabby <bitt@example.com>

# ntfy push delivery. https only. People choose a topic on their own profile;
# the server is pinned here so nobody can aim the app at a host of their own.
# BITT_NTFY_URL=https://ntfy.sh
# BITT_NTFY_TOKEN=file:/run/secrets/ntfy_token

# Reminder lead times and message templates. These are INSTANCE-WIDE defaults,
# and a tab whose provider has set its own reminders ignores them. Setting any
# BITT_REMINDER_* variable also takes the whole reminder form in the app
# read-only, since the environment wins.
#
# Templates fill in {tab} {amount} {due} {days} {when} {url} when sent.
# BITT_REMINDER_DAYS=14,7,1
# BITT_REMINDER_TITLE={tab}: {amount} due {when}
# BITT_REMINDER_BODY=Your {days}-day reminder: a payment on the tab "{tab}" is due {when}, on {due}.
# A single lead time can override the default pair, e.g.:
# BITT_REMINDER_TITLE_1=Last call -- {tab} is due tomorrow
