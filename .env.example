# BitTabby configuration
#
# DEPLOY-06: every value is supplied by the environment or by a file the
# environment points at. Nothing sensitive is committed. Any BITT_* value may
# use the form "file:/run/secrets/name" to read from a mounted file instead.

# Listen address
BITT_ADDR=:8080

# SQLite database file. The parent directory is created with owner-only
# permissions, and the database files are chmod 0600 on open.
BITT_DB_PATH=data/bitt.db

# Instance-wide timezone, used for every period boundary. Seeds the first-run
# setup screen; after setup the value stored in the database is authoritative.
BITT_TIMEZONE=America/New_York

# Set to false ONLY for local plain-HTTP development. Leaving this false on a
# networked deployment sends session cookies without the Secure flag.
BITT_SECURE_COOKIES=true

# LEDGER-01 append-only database triggers. Disable only for development or a
# deliberate manual repair; the server logs a warning when they are off.
BITT_LEDGER_TRIGGERS=true

# Request timeouts
BITT_READ_TIMEOUT=15s
BITT_WRITE_TIMEOUT=30s
BITT_SHUTDOWN_TIMEOUT=15s
