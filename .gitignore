# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
# The compose stacks read file-based secrets from ./secrets (tick secret, the
# MariaDB DSN with its password, an SMTP password). None of it may ever be
# committed -- ignore the whole directory.
/secrets/

# Data — never commit the financial store
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Build output
/bittabby
/dist/
/bin/
*.exe

# Go
*.test
*.out
coverage.*

# Generated assets
/internal/web/static/dist/
node_modules/

# Editor and OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
