package views

import "github.com/johnzastrow/bitt/internal/tz"

// Setup is the one-time first-run screen (AUTH-03). It is reachable only while
// no admin exists; once used, the route returns a redirect forever after.
templ Setup(p Page, timezone string) {
	@Layout(p) {
		<section class="card narrow">
			<h1>Welcome to BitTabby</h1>
			<p class="lede">
				This deployment has no accounts yet. Create the administrator account to get started.
				This screen appears once and then locks permanently.
			</p>
			<form method="post" action="/setup" class="stack">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<label>
					Your name
					<input type="text" name="display_name" required autocomplete="name" autofocus/>
				</label>
				<label>
					Email
					<input type="email" name="email" required autocomplete="username"/>
				</label>
				<label>
					Password
					<input type="password" name="password" required minlength="12" autocomplete="new-password"/>
					<small>At least 12 characters. Length matters more than symbols.</small>
				</label>
				<label>
					Timezone
					<input
						type="text"
						name="timezone"
						value={ timezone }
						list="timezone-options"
						autocomplete="off"
						spellcheck="false"
						required
					/>
					<small>
						Start typing a city or region &mdash; "York", "Berlin", "Kolkata". Used for every period
						boundary on this instance, and it cannot be changed here afterward.
					</small>
				</label>
				// A datalist rather than a select: 400 zones in a native select
				// is unusable, and its keyboard search matches only the start of
				// the value, so "York" would never find America/New_York. A
				// datalist substring-matches and needs no JavaScript, which the
				// content-security policy would forbid anyway.
				//
				// It does not constrain the field, which is deliberate -- a zone
				// this build's list has not caught up with can still be typed.
				// The handler validates with time.LoadLocation regardless.
				<datalist id="timezone-options">
					for _, zone := range tz.Zones() {
						<option value={ zone }></option>
					}
				</datalist>
				<button class="primary" type="submit">Create administrator</button>
			</form>
		</section>
	}
}

// Login is the sign-in screen (AUTH-02).
// Login keeps the existing signature for any caller that has no destination.
templ Login(p Page) {
	@LoginNext(p, "")
}

// LoginNext carries a validated local path through the form, so a link tapped
// from a notification survives the login it triggers.
templ LoginNext(p Page, next string) {
	@Layout(p) {
		<section class="card narrow">
			<h1>Sign in</h1>
			<form method="post" action="/login" class="stack">
				if next != "" {
					<input type="hidden" name="next" value={ next }/>
				}
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<label>
					Email
					<input type="email" name="email" required autocomplete="username" autofocus/>
				</label>
				<label>
					Password
					<input type="password" name="password" required autocomplete="current-password"/>
				</label>
				<button class="primary" type="submit">Sign in</button>
			</form>
		</section>
	}
}
