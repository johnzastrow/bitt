package views

import (
	"github.com/johnzastrow/bitt/internal/store"
	"github.com/johnzastrow/bitt/internal/version"
)

// Page carries the chrome-level data every rendered page needs.
type Page struct {
	Title     string
	User      *store.User
	CSRFToken string
	Flash     string
	Error     string
	// AssetVersion is a digest of the embedded assets, appended to their URLs
	// so a browser cannot serve a stylesheet from before the change that
	// mattered. The web package computes it; views cannot import web.
	AssetVersion string
}

// asset builds a cache-busting URL for an embedded asset. Every reference to
// /static/ goes through this -- a bare path is cached for a year by the
// handler's immutable rule only when it carries the digest, but it is still the
// kind of thing that goes stale in a browser for a minute, and there is no
// reason for any of them to be bare.
func (p Page) asset(name string) string {
	if p.AssetVersion == "" {
		return "/static/" + name
	}
	return "/static/" + name + "?v=" + p.AssetVersion
}

templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ pageTitle(p.Title) }</title>
			<link rel="stylesheet" href={ p.asset("app.css") }/>
			<script src={ p.asset("htmx.min.js") } defer></script>
			<script src={ p.asset("counter.js") } defer></script>
		</head>
		<body
			if p.CSRFToken != "" {
				hx-headers={ csrfHeader(p.CSRFToken) }
			}
		>
			if p.User != nil {
				<header class="topbar">
					<a class="brand" href="/">
						<img class="logo" src={ p.asset("logo.svg") } alt="" width="28" height="28"/>
						<span>BitTabby</span>
					</a>
					<nav>
						if p.User.IsAdmin {
							<a class="navlink" href="/admin/users">People</a>
							<a class="navlink" href="/admin/notifications">Notifications</a>
						}
						<a class="who" href="/profile" title="Your profile">
							@UserAvatar(*p.User, 26)
							<span>{ p.User.DisplayName }</span>
						</a>
						<form method="post" action="/logout" class="inline">
							<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
							<button class="link" type="submit">Log out</button>
						</form>
					</nav>
				</header>
			}
			<main class="wrap">
				if p.Error != "" {
					<div class="banner banner-error" role="alert">{ p.Error }</div>
				}
				if p.Flash != "" {
					<div class="banner banner-ok" role="status">{ p.Flash }</div>
				}
				{ children... }
			</main>
			<footer class="foot">
				<span>Tabs, not invoices.</span>
				<span class="version" title={ version.Full() }>{ version.Short() }</span>
			</footer>
		</body>
	</html>
}

func pageTitle(t string) string {
	if t == "" {
		return "BitTabby"
	}
	return t + " -- BitTabby"
}

// csrfHeader puts the token on every htmx request, so a request issued by
// script carries the same proof a form post does. templ escapes the attribute,
// and the token is base64url, so no injection is possible through it.
func csrfHeader(token string) string {
	return `{"X-CSRF-Token": "` + token + `"}`
}
