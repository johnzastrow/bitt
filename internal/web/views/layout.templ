package views

import "github.com/johnzastrow/bitt/internal/store"

// Page carries the chrome-level data every rendered page needs.
type Page struct {
	Title     string
	User      *store.User
	CSRFToken string
	Flash     string
	Error     string
}

templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ pageTitle(p.Title) }</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body
			if p.CSRFToken != "" {
				hx-headers={ csrfHeader(p.CSRFToken) }
			}
		>
			if p.User != nil {
				<header class="topbar">
					<a class="brand" href="/">BitTabby</a>
					<nav>
						if p.User.IsAdmin {
							<a class="navlink" href="/admin/users">People</a>
						}
						<span class="who">{ p.User.DisplayName }</span>
						<form method="post" action="/logout" class="inline">
							<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
							<button class="link" type="submit">Log out</button>
						</form>
					</nav>
				</header>
			}
			<main class="wrap">
				if p.Error != "" {
					<div class="banner banner-error" role="alert">{ p.Error }</div>
				}
				if p.Flash != "" {
					<div class="banner banner-ok" role="status">{ p.Flash }</div>
				}
				{ children... }
			</main>
			<footer class="foot">
				<span>Tabs, not invoices.</span>
			</footer>
		</body>
	</html>
}

func pageTitle(t string) string {
	if t == "" {
		return "BitTabby"
	}
	return t + " -- BitTabby"
}

// csrfHeader puts the token on every htmx request, so a request issued by
// script carries the same proof a form post does. templ escapes the attribute,
// and the token is base64url, so no injection is possible through it.
func csrfHeader(token string) string {
	return `{"X-CSRF-Token": "` + token + `"}`
}
