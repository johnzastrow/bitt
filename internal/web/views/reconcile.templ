package views

import (
	"strconv"
	"strings"
	"time"

	"github.com/johnzastrow/bitt/internal/bankcsv"
	"github.com/johnzastrow/bitt/internal/money"
	"github.com/johnzastrow/bitt/internal/reconcile"
	"github.com/johnzastrow/bitt/internal/store"
)

// ReconcileData is the Reconciliation screen (SPEC-BANK-RECONCILE section 10).
type ReconcileData struct {
	Imports     []store.BankImport
	Formats     []store.BankFormat
	Settings    store.ReconcileSettings
	Rules       []store.IgnoreRule
	Suggestions Suggestions
	Matches     []store.BankMatch
}

// Suggestions is a matching run joined back to its rows (RECON-03).
type Suggestions struct {
	Matches           []SuggestedMatch
	Ties              []SuggestedTie
	UnmatchedLines    []store.OpenBankLine
	Small             int // open lines below the minimum, not offered
	UnmatchedPayments []store.PaymentCandidate
}

// SuggestedMatch is one proposed pair.
type SuggestedMatch struct {
	Line        store.OpenBankLine
	Payment     store.PaymentCandidate
	Suggestion  reconcile.Suggestion
	DateFlagged bool
}

// SuggestedTie is a group that scored the same: a person picks.
type SuggestedTie struct {
	Lines    []store.OpenBankLine
	Payments []store.PaymentCandidate
}

// Reconcile is the bank reconciliation home: upload, and the recent imports.
// Suggested matches and unmatched lines are added from RECON-03 on.
templ Reconcile(p Page, d ReconcileData) {
	@Layout(p) {
		<h1>Reconciliation</h1>
		<section class="card">
			<h2>Import a bank statement</h2>
			<form method="post" action="/admin/reconcile/upload" enctype="multipart/form-data" class="stack">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<label>
					CSV export from your bank
					<input type="file" name="statement" accept=".csv,text/csv" required/>
					<small>One file at a time, up to 5 MB. Only money received is kept; payments out are counted and dropped. Lines already imported from another file are skipped.</small>
				</label>
				<button class="primary" type="submit">Upload</button>
			</form>
		</section>
		@suggestionsSection(p, d.Suggestions, d.Settings)
		@matchesSection(p, d.Matches)
		<section class="card">
			<h2>Recent imports</h2>
			if len(d.Imports) == 0 {
				<p class="muted">Nothing imported yet.</p>
			} else {
				<ul class="importlist">
					for _, imp := range d.Imports {
						<li>
							<a href={ importURL(imp.ID) }>{ imp.FileName }</a>
							<span class="muted small">
								{ imp.FormatName } &middot; { imp.UploadedAt.Format("Jan 2, 2006") } by { imp.UploaderName }
							</span>
							<span class="small">{ importCounts(imp) }</span>
						</li>
					}
				</ul>
			}
		</section>
		@setupSection(p, d)
		if len(d.Formats) > 0 {
			<section class="card">
				<h2>Saved layouts</h2>
				<ul class="importlist">
					for _, f := range d.Formats {
						<li>
							<span>{ f.Name }</span>
							<span class="muted small mono">{ f.HeaderText }</span>
						</li>
					}
				</ul>
			</section>
		}
	}
}

func importURL(id int64) templ.SafeURL {
	return templ.SafeURL("/admin/reconcile/imports/" + strconv.FormatInt(id, 10))
}

// importCounts is an import's outcome in one line.
func importCounts(i store.BankImport) string {
	parts := []string{strconv.Itoa(i.Kept) + " kept"}
	if i.Duplicates > 0 {
		parts = append(parts, strconv.Itoa(i.Duplicates)+" already imported")
	}
	if i.Ignored > 0 {
		parts = append(parts, strconv.Itoa(i.Ignored)+" ignored")
	}
	parts = append(parts, strconv.Itoa(i.Outgoing)+" outgoing")
	if i.Refused > 0 {
		parts = append(parts, strconv.Itoa(i.Refused)+" unreadable")
	}
	return strings.Join(parts, ", ")
}

// ReconcileMapData is the "Map this layout" screen.
type ReconcileMapData struct {
	Token       string
	FileName    string
	Header      []string
	Mapping     bankcsv.Mapping
	Name        string
	Problem     string
	DateLayouts []bankcsv.DateLayout
	Rows        int
	// Preview is the first rows under Mapping; empty while the mapping is
	// incomplete. PreviewOf ties a save to this exact preview.
	Preview   []bankcsv.PreviewRow
	PreviewOf string
}

// ReconcileMap asks once how to read a layout the instance has not seen.
templ ReconcileMap(p Page, d ReconcileMapData) {
	@Layout(p) {
		<h1>Map this layout</h1>
		<p class="muted">
			{ d.FileName } has a header this instance has not seen ({ strconv.Itoa(len(d.Header)) } columns,
			{ strconv.Itoa(d.Rows) } rows). Say which column is which; the next file with the same header will
			import without asking.
		</p>
		if d.Problem != "" {
			<div class="banner banner-error" role="alert">{ d.Problem }</div>
		}
		<form method="post" action={ mapURL(d.Token) } class="card stack">
			<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
			<input type="hidden" name="preview_of" value={ d.PreviewOf }/>
			@columnSelect("Date", "date", d.Header, d.Mapping.Date, false)
			<label>
				Date layout
				<select name="date_layout">
					for _, l := range d.DateLayouts {
						<option value={ l.Key } selected?={ l.Key == d.Mapping.DateLayout }>{ l.Label }</option>
					}
				</select>
			</label>
			@columnSelect("Amount (one signed column)", "amount", d.Header, d.Mapping.Amount, true)
			<p class="muted small">Or, if the export has separate columns for money out and money in, leave Amount unset and choose both:</p>
			@columnSelect("Debit (money out)", "debit", d.Header, d.Mapping.Debit, true)
			@columnSelect("Credit (money in)", "credit", d.Header, d.Mapping.Credit, true)
			<label>
				In a single amount column, money received is
				<select name="incoming">
					<option value="positive" selected?={ !d.Mapping.IncomingNegative }>positive (a deposit is 150.00)</option>
					<option value="negative" selected?={ d.Mapping.IncomingNegative }>negative (a deposit is -150.00)</option>
				</select>
			</label>
			<label class="checkrow">
				<input type="checkbox" name="decimal_comma" value="1" checked?={ d.Mapping.DecimalComma }/>
				Amounts use a decimal comma (1.234,56)
			</label>
			@columnSelect("Description", "description", d.Header, d.Mapping.Description, false)
			@columnSelect("Account (optional)", "account", d.Header, d.Mapping.Account, true)
			@columnSelect("Note (optional)", "note", d.Header, d.Mapping.Note, true)
			@columnSelect("Reference or check number (optional)", "reference", d.Header, d.Mapping.Reference, true)
			<label>
				Name for this layout
				<input type="text" name="name" value={ d.Name } maxlength="120" required placeholder="Credit union, checking"/>
			</label>
			<div class="actions">
				<button type="submit" name="action" value="preview">Preview</button>
				if len(d.Preview) > 0 {
					<button class="primary" type="submit" name="action" value="save">Save layout and import</button>
				}
			</div>
		</form>
		if len(d.Preview) > 0 {
			<section class="card">
				<h2>First { strconv.Itoa(len(d.Preview)) } rows, read this way</h2>
				<ul class="banklines">
					for _, row := range d.Preview {
						<li class={ "bankline", "outcome-" + row.Outcome }>
							<div class="bankline-head">
								<span class="muted small">Row { strconv.Itoa(row.Row) }</span>
								switch row.Outcome {
									case "in":
										<span class="pill pill-payment">in</span>
										<span class="nowrap">{ row.Line.PostedOn.Format("Jan 2, 2006") }</span>
										<span class="amount">{ row.Line.Amount.Display() }</span>
									case "out":
										<span class="pill">out, dropped</span>
									default:
										<span class="pill pill-fault">unreadable</span>
								}
							</div>
							if row.Outcome == "in" {
								@bankText(row.Line.Description, row.Line.Account, row.Line.Note, row.Line.Reference)
							} else if row.Outcome == "refused" {
								<p class="small">This row { row.Reason }.</p>
							}
						</li>
					}
				</ul>
			</section>
		}
	}
}

// bankDate shows a stored "YYYY-MM-DD" the way the rest of the screens do.
func bankDate(s string) string {
	d, err := time.Parse("2006-01-02", s)
	if err != nil {
		return s
	}
	return d.Format("Jan 2, 2006")
}

func mapURL(token string) templ.SafeURL {
	return templ.SafeURL("/admin/reconcile/map/" + token)
}

// columnSelect offers the file's columns for one field, each labelled with its
// header name so the choice is made by name, not by position.
templ columnSelect(label, name string, header []string, selected int, optional bool) {
	<label>
		{ label }
		<select name={ name }>
			if optional {
				<option value="-1" selected?={ selected == bankcsv.None }>(not in this file)</option>
			}
			for i, h := range header {
				<option value={ strconv.Itoa(i) } selected?={ selected == i }>{ columnLabel(i, h) }</option>
			}
		</select>
	</label>
}

func columnLabel(i int, h string) string {
	h = strings.TrimSpace(h)
	if h == "" {
		h = "(untitled)"
	}
	return strconv.Itoa(i+1) + ". " + h
}

// bankText is a bank line's free text: description, then account, note and
// reference when present. Line breaks are kept (the reference export puts the
// sender on a description's second line), and the note is shown verbatim
// wherever the line is shown (spec section 2).
templ bankText(description, account, note, reference string) {
	<p class="banktext">{ description }</p>
	if account != "" || reference != "" {
		<p class="muted small">
			if account != "" {
				{ account }
			}
			if account != "" && reference != "" {
				&middot;
			}
			if reference != "" {
				Ref { reference }
			}
		</p>
	}
	if note != "" {
		<p class="banknote small"><span class="muted">Bank note:</span> { note }</p>
	}
}

// ReconcileImport is one import: what happened to its rows, and the lines it
// kept.
templ ReconcileImport(p Page, imp store.BankImport, lines []store.BankLine) {
	@Layout(p) {
		<p class="muted small"><a href="/admin/reconcile">Reconciliation</a></p>
		<h1>{ imp.FileName }</h1>
		<section class="card">
			<p>
				{ imp.FormatName } &middot; uploaded { imp.UploadedAt.Format("Jan 2, 2006 15:04") } UTC by { imp.UploaderName }
			</p>
			<ul class="statuslist">
				<li>{ strconv.Itoa(imp.Kept) } new lines kept</li>
				<li>{ strconv.Itoa(imp.Duplicates) } already imported from another file</li>
				<li>{ strconv.Itoa(imp.Ignored) } ignored by a rule</li>
				<li>{ strconv.Itoa(imp.Outgoing) } outgoing (or zero), counted and dropped</li>
				<li>{ strconv.Itoa(imp.Refused) } rows that could not be read</li>
			</ul>
			if imp.FirstDate != "" {
				<p class="muted small">Incoming lines from { bankDate(imp.FirstDate) } to { bankDate(imp.LastDate) }.</p>
			}
			if imp.RefusedDetail != "" {
				<details>
					<summary>Why rows could not be read</summary>
					<pre class="refused">{ imp.RefusedDetail }</pre>
				</details>
			}
		</section>
		<section class="card">
			<h2>Lines kept</h2>
			if len(lines) == 0 {
				<p class="muted">No new lines in this file.</p>
			} else {
				<ul class="banklines">
					for _, l := range lines {
						<li class={ "bankline", "state-" + string(l.State) }>
							<div class="bankline-head">
								<span class="muted small">Row { strconv.Itoa(l.Row) }</span>
								<span class="nowrap">{ bankDate(l.PostedOn) }</span>
								<span class="amount">{ l.Amount.Display() }</span>
								if l.State != store.BankLineOpen {
									<span class="pill">{ string(l.State) }</span>
								}
							</div>
							@bankText(l.Description, l.Account, l.Note, l.Reference)
							if l.IgnoreReason != "" {
								<p class="muted small">Ignored: { l.IgnoreReason }</p>
							}
							<details class="small">
								<summary>Original row</summary>
								<pre class="rawrow">{ l.Raw }</pre>
							</details>
							<p class="small"><a href={ lineURL(l.ID) }>Line details and history</a></p>
						</li>
					}
				</ul>
			}
		</section>
	}
}

// suggestionsSection is the open work: proposed matches, ties, and lines with
// no candidate. Read-only until RECON-04 adds Confirm.
templ suggestionsSection(p Page, sg Suggestions, set store.ReconcileSettings) {
	<section class="card">
		<h2>Suggested matches</h2>
		if len(sg.Matches) == 0 && len(sg.Ties) == 0 {
			<p class="muted">No suggestions. Import a statement, or widen the setup below.</p>
		}
		if n := exactCount(sg.Matches); n > 0 {
			<form method="post" action="/admin/reconcile/confirm-exact" class="confirmall">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<button class="primary" type="submit">Confirm all { strconv.Itoa(n) } exact matches</button>
				<span class="muted small">Same amount, so nothing is posted; each is only recorded.</span>
			</form>
		}
		<ul class="banklines">
			for _, m := range sg.Matches {
				<li class="bankline matchcard">
					<div class="matchsides">
						@bankSide(m.Line)
						@paymentSide(m.Payment)
					</div>
					<p class="small matchwhy">
						if m.Suggestion.Exact {
							Same amount.
						} else {
							Differs by { m.Suggestion.AmountDiff.Display() }.
						}
						if m.Suggestion.DateDiff != 0 {
							{ daysApart(m.Suggestion.DateDiff) }.
						}
						if m.Suggestion.NameHit {
							A name matches.
						}
					</p>
					if m.DateFlagged {
						<p class="small flag">Dates differ by more than { strconv.Itoa(set.DateFlagDays) } days; confirming will flag it.</p>
					}
					<p class="small"><strong>Confirming will post:</strong> { deltaText(m.Line.Amount, m.Payment.Amount) }</p>
					@confirmForm(p, m.Line, m.Payment, "Confirm")
				</li>
			}
		</ul>
		for _, t := range sg.Ties {
			<div class="tie">
				<h3>{ tieTitle(len(t.Lines), len(t.Payments)) }</h3>
				<p class="muted small">These scored the same, so none is suggested. Pick by hand.</p>
				for _, l := range t.Lines {
					for _, pay := range t.Payments {
						<div class="tiepair">
							<div class="matchsides">
								@bankSide(l)
								@paymentSide(pay)
							</div>
							<p class="small"><strong>Confirming will post:</strong> { deltaText(l.Amount, pay.Amount) }</p>
							@confirmForm(p, l, pay, "Confirm this pair")
						</div>
					}
				}
			</div>
		}
	</section>
	<section class="card">
		<h2>Bank lines with no matching payment</h2>
		if len(sg.UnmatchedLines) == 0 {
			<p class="muted">None.</p>
		} else {
			<ul class="banklines">
				for _, l := range sg.UnmatchedLines {
					<li class="bankline">
						@bankSide(l)
					</li>
				}
			</ul>
		}
		if sg.Small > 0 {
			<p class="muted small">{ strconv.Itoa(sg.Small) } open lines below the { set.MinLineAmount.Display() } minimum are not offered.</p>
		}
	</section>
	if len(sg.UnmatchedPayments) > 0 {
		<details class="card">
			<summary>{ strconv.Itoa(len(sg.UnmatchedPayments)) } recorded payments with no bank line nearby</summary>
			<p class="muted small">Cash, or a bank that has not been imported. For information only.</p>
			<ul class="banklines">
				for _, p := range sg.UnmatchedPayments {
					<li class="bankline">
						@paymentSide(p)
					</li>
				}
			</ul>
		</details>
	}
}

templ bankSide(l store.OpenBankLine) {
	<div class="matchside">
		<div class="bankline-head">
			<span class="pill">bank</span>
			<span class="nowrap">{ bankDate(l.PostedOn) }</span>
			<span class="amount">{ l.Amount.Display() }</span>
		</div>
		@bankText(l.Description, l.Account, l.Note, l.Reference)
		<p class="muted small">
			Row { strconv.Itoa(l.Row) } of { l.FileName } &middot;
			<a href={ lineURL(l.ID) }>Line details, record or ignore</a>
		</p>
	</div>
}

templ paymentSide(p store.PaymentCandidate) {
	<div class="matchside">
		<div class="bankline-head">
			<span class="pill pill-payment">recorded</span>
			<span class="nowrap">{ p.EffectiveAt.Format("Jan 2, 2006") }</span>
			<span class="amount">{ p.Amount.Display() }</span>
		</div>
		<p>
			<a href={ tabURL(p.TabID) }>{ p.TabName }</a>
			<span class="muted small">&middot; { string(p.Method) } &middot; recorded by { p.ActorName }</span>
		</p>
		if p.Memo != "" {
			<p class="muted small banktext">{ p.Memo }</p>
		}
	</div>
}

func tabURL(id int64) templ.SafeURL {
	return templ.SafeURL("/tabs/" + strconv.FormatInt(id, 10))
}

// deltaText says what confirming a match will post (spec section 8).
func deltaText(bank, recorded money.Cents) string {
	switch {
	case bank > recorded:
		return "a payment of " + (bank - recorded).Display() + " for the extra the bank received."
	case bank < recorded:
		return "a debit adjustment of " + (recorded - bank).Display() + ", recorded but not received."
	}
	return "nothing; the match is recorded."
}

func daysApart(diff int) string {
	n := diff
	if n < 0 {
		n = -n
	}
	unit := " days"
	if n == 1 {
		unit = " day"
	}
	if diff > 0 {
		return "Bank date " + strconv.Itoa(n) + unit + " later"
	}
	return "Bank date " + strconv.Itoa(n) + unit + " earlier"
}

func tieTitle(lines, payments int) string {
	if lines == 1 {
		return strconv.Itoa(payments) + " possible payments for one bank line"
	}
	if payments == 1 {
		return strconv.Itoa(lines) + " possible bank lines for one payment"
	}
	return strconv.Itoa(lines) + " bank lines and " + strconv.Itoa(payments) + " payments that could pair either way"
}

// setupSection is the Reconciliation setup controls and ignore rules.
templ setupSection(p Page, d ReconcileData) {
	<section class="card" id="setup">
		<h2>Setup</h2>
		<form method="post" action="/admin/reconcile/settings" class="stack">
			<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
			<label>
				Date window, days either side (0 to 60)
				<input type="number" name="date_window_days" min="0" max="60" required value={ strconv.Itoa(d.Settings.DateWindowDays) }/>
			</label>
			<label>
				Amount tolerance, percent of the recorded amount (0 to 100)
				<input type="number" name="tolerance_percent" min="0" max="100" required value={ strconv.Itoa(d.Settings.TolerancePercent) }/>
			</label>
			<label>
				Tolerance at most, $ (0 to 10,000)
				<input type="text" inputmode="decimal" name="tolerance_cap" required value={ d.Settings.ToleranceCap.String() }/>
			</label>
			<label>
				Tolerance at least, $ (0 to 100)
				<input type="text" inputmode="decimal" name="tolerance_floor" required value={ d.Settings.ToleranceFloor.String() }/>
			</label>
			<label>
				Minimum line amount, $ (0 to 10,000)
				<input type="text" inputmode="decimal" name="min_line_amount" required value={ d.Settings.MinLineAmount.String() }/>
				<small>Smaller lines, such as monthly dividends, are not offered for matching.</small>
			</label>
			<label class="checkrow">
				<input type="checkbox" name="use_names" value="1" checked?={ d.Settings.UseNames }/>
				Use names: look for a participant&#39;s or the tab&#39;s name in the bank description
			</label>
			<label>
				Flag dates that differ by more than, days (0 to 60)
				<input type="number" name="date_flag_days" min="0" max="60" required value={ strconv.Itoa(d.Settings.DateFlagDays) }/>
			</label>
			<button class="primary" type="submit">Save setup</button>
			if d.Settings.UpdatedBy != 0 {
				<p class="muted small">Last changed { d.Settings.UpdatedAt.Format("Jan 2, 2006 15:04") } UTC by { d.Settings.UpdatedByName }.</p>
			}
		</form>
		<h3>Ignore rules</h3>
		<p class="muted small">A line whose description contains the text is imported as ignored, with the rule as the reason. Adding a rule also ignores matching lines still open.</p>
		if len(d.Rules) > 0 {
			<ul class="importlist">
				for _, r := range d.Rules {
					<li>
						<span>{ r.FormatName }: description contains &ldquo;{ r.Contains }&rdquo;</span>
						<form method="post" action={ ruleDeleteURL(r.ID) } class="inline">
							<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
							<button class="link" type="submit">Remove</button>
						</form>
					</li>
				}
			</ul>
		}
		if len(d.Formats) == 0 {
			<p class="muted small">Import a statement first; rules belong to a layout.</p>
		} else {
			<form method="post" action="/admin/reconcile/rules" class="stack">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<label>
					Layout
					<select name="format_id">
						for _, f := range d.Formats {
							<option value={ strconv.FormatInt(f.ID, 10) }>{ f.Name }</option>
						}
					</select>
				</label>
				<label>
					Description contains
					<input type="text" name="contains" maxlength="120" required placeholder="Deposit Dividend"/>
				</label>
				<button type="submit">Add rule</button>
			</form>
		}
	</section>
}

func ruleDeleteURL(id int64) templ.SafeURL {
	return templ.SafeURL("/admin/reconcile/rules/" + strconv.FormatInt(id, 10) + "/delete")
}

func exactCount(ms []SuggestedMatch) int {
	n := 0
	for _, m := range ms {
		if m.Suggestion.Exact {
			n++
		}
	}
	return n
}

// confirmForm confirms one pair. The bank-note checkbox appears only when the
// line has a note and confirming would post an entry for it to go into; it is
// off by default, since a memo is permanent and seen by everyone on the tab.
templ confirmForm(p Page, l store.OpenBankLine, pay store.PaymentCandidate, label string) {
	<form method="post" action="/admin/reconcile/confirm" class="confirmform">
		<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
		<input type="hidden" name="line_id" value={ strconv.FormatInt(l.ID, 10) }/>
		<input type="hidden" name="entry_seq" value={ strconv.FormatInt(pay.Seq, 10) }/>
		if l.Note != "" && l.Amount != pay.Amount {
			<label class="checkrow small">
				<input type="checkbox" name="include_note" value="1"/>
				Include the bank note in the entry (everyone on the tab will see it)
			</label>
		}
		<button class="primary" type="submit">{ label }</button>
	</form>
}

// matchesSection lists recent matches, undone ones included, with Undo on
// those that stand.
templ matchesSection(p Page, ms []store.BankMatch) {
	if len(ms) > 0 {
		<section class="card">
			<h2>Recent matches</h2>
			<ul class="banklines">
				for _, m := range ms {
					<li class={ "bankline", templ.KV("undone", !m.Active()) }>
						<div class="bankline-head">
							<a href={ tabURL(m.TabID) }>{ m.TabName }</a>
							<span class="nowrap">{ bankDate(m.BankDate) }</span>
							<span class="amount">{ m.BankAmount.Display() }</span>
							if !m.Active() {
								<span class="pill">unmade</span>
							}
							if m.DateFlagged {
								<span class="pill pill-fault">date flagged</span>
							}
						</div>
						<p class="small">
							Recorded { m.RecordedAmount.Display() } on { bankDate(m.RecordedDate) }.
							{ matchDeltaText(m) }
						</p>
						if m.DateFlagged {
							<p class="small flag">{ m.DateFlagReason }.</p>
						}
						<p class="muted small">
							Row { strconv.Itoa(m.Row) } of { m.FileName } &middot; confirmed by { m.ConfirmedByName }
							{ m.ConfirmedAt.Format("Jan 2, 2006 15:04") } UTC
						</p>
						if !m.Active() {
							<p class="muted small">
								Unmade { m.UndoneAt.Format("Jan 2, 2006 15:04") } UTC by { m.UndoneByName }: { m.UndoReason }.
							</p>
						}
						if m.Active() {
							<form method="post" action={ undoURL(m.ID) } class="inline">
								<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
								<button class="link" type="submit">Undo this match</button>
							</form>
						}
					</li>
				}
			</ul>
		</section>
	}
}

func undoURL(id int64) templ.SafeURL {
	return templ.SafeURL("/admin/reconcile/matches/" + strconv.FormatInt(id, 10) + "/undo")
}

func matchDeltaText(m store.BankMatch) string {
	switch m.DeltaKind {
	case store.KindPayment:
		return "Posted a payment of " + m.DeltaAmount.Display() + "."
	case store.KindAdjustment:
		return "Posted a debit adjustment of " + (-m.DeltaAmount).Display() + "."
	}
	return "Nothing posted."
}

func lineURL(id int64) templ.SafeURL {
	return templ.SafeURL("/admin/reconcile/lines/" + strconv.FormatInt(id, 10))
}

func linePostURL(id int64, action string) templ.SafeURL {
	return templ.SafeURL("/admin/reconcile/lines/" + strconv.FormatInt(id, 10) + "/" + action)
}

// TabChoice is a tab a line could be recorded on.
type TabChoice struct {
	ID     int64
	Name   string
	People string
	Likely bool // its name or a participant's appears in the line
}

// LineData is one bank line's page (RECON-05).
type LineData struct {
	Line        store.OpenBankLine
	Events      []store.BankLineEvent
	Matches     []store.BankMatch
	Recorded    *store.Entry
	RecordedTab string
	Tabs        []TabChoice // open lines only
	Memo        string
}

// ReconcileLine shows a bank line, what has happened to it and who did it,
// and the action its state allows.
templ ReconcileLine(p Page, d LineData) {
	@Layout(p) {
		<p class="muted small"><a href="/admin/reconcile">Reconciliation</a></p>
		<h1>Bank line</h1>
		<section class="card">
			<div class="bankline-head">
				<span class="pill">{ string(d.Line.State) }</span>
				<span class="nowrap">{ bankDate(d.Line.PostedOn) }</span>
				<span class="amount">{ d.Line.Amount.Display() }</span>
			</div>
			@bankText(d.Line.Description, d.Line.Account, d.Line.Note, d.Line.Reference)
			<p class="muted small">Row { strconv.Itoa(d.Line.Row) } of { d.Line.FileName }</p>
			<details class="small">
				<summary>Original row</summary>
				<pre class="rawrow">{ d.Line.Raw }</pre>
			</details>
		</section>
		switch d.Line.State {
			case store.BankLineOpen:
				@recordLineForm(p, d)
				<section class="card">
					<h2>Not BitTabby</h2>
					<p class="muted small">For money that has nothing to do with a tab. The line is hidden until un-ignored.</p>
					<form method="post" action={ linePostURL(d.Line.ID, "ignore") } class="stack">
						<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
						<label>
							Note (optional)
							<input type="text" name="note" maxlength="500" placeholder="Refund from the utility"/>
						</label>
						<button type="submit">Mark Not BitTabby</button>
					</form>
				</section>
			case store.BankLineRecorded:
				<section class="card">
					<h2>Recorded as a payment</h2>
					if d.Recorded != nil {
						<p>
							{ d.Recorded.Amount.Display() } on <a href={ tabURL(d.Recorded.TabID) }>{ d.RecordedTab }</a>,
							{ string(d.Recorded.Method) }.
						</p>
						<p class="muted small banktext">{ d.Recorded.Memo }</p>
					}
					<form method="post" action={ linePostURL(d.Line.ID, "unrecord") } class="inline">
						<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
						<button type="submit">Undo the recording</button>
					</form>
					<p class="muted small">Reverses the payment and opens the line again. Undoing the payment on its tab does the same.</p>
				</section>
			case store.BankLineIgnored:
				<section class="card">
					<h2>Ignored</h2>
					<p>{ d.Line.IgnoreReason }</p>
					if d.Line.IgnoreNote != "" {
						<p class="muted small banktext">{ d.Line.IgnoreNote }</p>
					}
					<form method="post" action={ linePostURL(d.Line.ID, "unignore") } class="inline">
						<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
						<button type="submit">Un-ignore</button>
					</form>
				</section>
		}
		<section class="card">
			<h2>History</h2>
			if len(d.Events) == 0 && len(d.Matches) == 0 {
				<p class="muted">Imported; nothing done to it since.</p>
			}
			<ul class="statuslist">
				for _, m := range d.Matches {
					<li>
						Matched to <a href={ tabURL(m.TabID) }>{ m.TabName }</a> by { m.ConfirmedByName },
						{ m.ConfirmedAt.Format("Jan 2, 2006 15:04") } UTC. { matchDeltaText(m) }
						if m.Active() {
							<form method="post" action={ undoURL(m.ID) } class="inline">
								<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
								<button class="link" type="submit">Undo this match</button>
							</form>
						} else {
							<br/>
							<span class="muted small">
								Unmade { m.UndoneAt.Format("Jan 2, 2006 15:04") } UTC by { m.UndoneByName }: { m.UndoReason }.
							</span>
						}
					</li>
				}
				for _, ev := range d.Events {
					<li>
						{ eventText(ev.Action) } by { ev.ByName }, { ev.At.Format("Jan 2, 2006 15:04") } UTC.
						if ev.Note != "" {
							<span class="muted small">{ ev.Note }</span>
						}
					</li>
				}
			</ul>
		</section>
	}
}

func eventText(action string) string {
	switch action {
	case "recorded":
		return "Recorded as a payment"
	case "unrecorded":
		return "Recording undone"
	case "ignored":
		return "Marked Not BitTabby"
	case "unignored":
		return "Un-ignored"
	}
	return action
}

templ recordLineForm(p Page, d LineData) {
	<section class="card">
		<h2>Record as a payment</h2>
		<p class="muted small">
			For money that arrived but was never recorded. Posts { d.Line.Amount.Display() } on
			{ bankDate(d.Line.PostedOn) } to the tab you choose, attributed to you.
		</p>
		if len(d.Tabs) == 0 {
			<p class="muted">There are no open tabs to record it on.</p>
		} else {
			<form method="post" action={ linePostURL(d.Line.ID, "record") } class="stack">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<label>
					Tab
					<select name="tab_id" required>
						for _, t := range d.Tabs {
							<option value={ strconv.FormatInt(t.ID, 10) }>{ tabChoiceLabel(t) }</option>
						}
					</select>
					<small>Tabs whose name or people appear in the line are listed first.</small>
				</label>
				<label>
					How it arrived
					<select name="method">
						<option value="transfer" selected>Transfer</option>
						<option value="other">Other</option>
					</select>
				</label>
				<label>
					Note on the entry
					<input type="text" name="memo" maxlength="500" value={ d.Memo }/>
				</label>
				if d.Line.Note != "" {
					<label class="checkrow small">
						<input type="checkbox" name="include_note" value="1"/>
						Include the bank note in the entry (everyone on the tab will see it)
					</label>
				}
				<button class="primary" type="submit">Record payment</button>
			</form>
		}
	</section>
}

func tabChoiceLabel(t TabChoice) string {
	label := t.Name
	if t.People != "" {
		label += " (" + t.People + ")"
	}
	if t.Likely {
		label += " -- likely"
	}
	return label
}
