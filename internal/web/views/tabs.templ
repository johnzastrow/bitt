package views

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/johnzastrow/bitt/internal/fee"
	"github.com/johnzastrow/bitt/internal/ledger"
	"github.com/johnzastrow/bitt/internal/money"
	"github.com/johnzastrow/bitt/internal/schedule"
	"github.com/johnzastrow/bitt/internal/store"
)

// TabCard is a dashboard row: a tab, its derived balance, and what the viewer
// is allowed to do with it.
type TabCard struct {
	Tab     store.Tab
	Balance money.Cents
	// Role is the viewer's role on this tab.
	Role store.Role
	// SettleAmount is what a one-tap settle would pay: the outstanding balance,
	// or zero when nothing is owed (UI-03 prefill).
	SettleAmount money.Cents
	// IdempotencyKey is minted per render, so a double-tapped settle posts once
	// (LEDGER-07).
	IdempotencyKey string
	// NextDue is when the tab's next scheduled charge lands, zero if the tab is
	// billed by hand (SCHED-05).
	NextDue schedule.Date
	// JustPosted counts the cycles this very render brought current, so a
	// balance that moved on load says why (SCHED-03).
	JustPosted int
	// JustFined counts the late fees this render assessed (FEE-03).
	JustFined int
	// JustInterest counts the interest charges this render accrued.
	JustInterest int
	// Payoff carries loan progress for a Payoff tab, nil for a Services tab
	// (PAYOFF-01).
	Payoff *ledger.Payoff
	// Custom opens the settle amount for editing, so a partial payment or a
	// payment beyond the balance can be recorded from the dashboard (PAY-05).
	Custom bool
	// Error is a message about what was just typed, shown on the card itself
	// rather than as a status code htmx would decline to swap.
	Error string
}

// CanSettle reports whether the settle control should appear.
func (c TabCard) CanSettle() bool { return c.SettleAmount > 0 }

// Scheduled reports whether the tab bills itself.
func (c TabCard) Scheduled() bool { return !c.NextDue.IsZero() }

// IsPayoff reports whether this card is for a Payoff tab.
func (c TabCard) IsPayoff() bool { return c.Payoff != nil }

// Settled reports whether a Payoff tab is fully paid (PAYOFF-03).
func (c TabCard) Settled() bool { return c.Payoff != nil && c.Payoff.Settled() }

// Inactive reports whether the card should sit below the active tabs: archived,
// or a settled Payoff loan.
func (c TabCard) Inactive() bool { return c.Tab.ArchivedAt != nil || c.Settled() }

// Dashboard lists the tabs the signed-in user participates in (UI-01).
templ Dashboard(p Page, cards []TabCard) {
	@Layout(p) {
		<div class="rowbetween">
			<h1>Your tabs</h1>
			<a class="primary button" href="/tabs/new">New tab</a>
		</div>
		if len(cards) == 0 {
			<section class="card empty">
				<p>No tabs yet.</p>
				<p class="muted">A tab tracks what one person owes another for something shared -- a phone plan, insurance, a loan.</p>
				<a class="primary button" href="/tabs/new">Create your first tab</a>
			</section>
		} else {
			<ul class="cards">
				for _, c := range cards {
					<li id={ cardID(c.Tab.ID) }>
						@TabCardView(p, c)
					</li>
				}
			</ul>
		}
	}
}

// TabCardView renders one dashboard card. It is also returned on its own as the
// htmx response to a settle, so the card updates in place (UI-03).
templ TabCardView(p Page, c TabCard) {
	<div class={ "card", "tabcard", balanceClass(c.Balance), archivedClass(c.Tab), settledClass(c) }>
		<a class="cardhead" href={ tabHref(c.Tab.ID) }>
			<div class="rowbetween">
				<h2>{ c.Tab.Name }</h2>
				if c.IsPayoff() {
					<span class={ "amount", balanceClass(c.Balance) }>{ c.Payoff.Remaining.Display() }</span>
				} else {
					<span class={ "amount", balanceClass(c.Balance) }>{ c.Balance.Display() }</span>
				}
			</div>
			if c.IsPayoff() {
				<p class="muted small">
					{ payoffSummary(*c.Payoff) } &middot; you are the { string(c.Role) }
					if c.Tab.ArchivedAt != nil {
						&middot; archived
					}
				</p>
				@ProgressBar(*c.Payoff)
				<p class={ "small", "statusline", payoffStatusClass(c.Payoff.Status) }>{ c.Payoff.Status.Label() }</p>
			} else {
				<p class="muted small">
					{ balanceLabel(c.Balance) } &middot; you are the { string(c.Role) }
					if c.Tab.ArchivedAt != nil {
						&middot; archived
					}
				</p>
				if c.Scheduled() {
					<p class="muted small">Next charge { c.NextDue.Display() }</p>
				}
			}
			if c.JustPosted > 0 {
				<p class="small posted">{ postedNote(c.JustPosted) }</p>
			}
			if c.JustFined > 0 {
				<p class="small posted">{ finedNote(c.JustFined) }</p>
			}
		</a>
		<div class="cardfoot">
			if c.CanSettle() {
				<button
					class="primary settle"
					hx-get={ settleConfirmPath(c.Tab.ID) }
					hx-target={ "#" + cardID(c.Tab.ID) }
					hx-swap="innerHTML"
				>
					{ fmt.Sprintf("Settle %s", c.SettleAmount.Display()) }
				</button>
				<button
					class="ghost settle"
					hx-get={ settleCustomPath(c.Tab.ID) }
					hx-target={ "#" + cardID(c.Tab.ID) }
					hx-swap="innerHTML"
				>Other amount</button>
			} else {
				// Nothing is owed, but paying ahead is still allowed and builds
				// a credit against the next charge (PAY-05).
				<button
					class="ghost settle"
					hx-get={ settleCustomPath(c.Tab.ID) }
					hx-target={ "#" + cardID(c.Tab.ID) }
					hx-swap="innerHTML"
				>Record a payment</button>
			}
		</div>
	</div>
}

// SettleConfirm is the second half of "one tap plus one confirmation" (UI-03).
//
// Two modes. The default prefills the whole outstanding balance and needs no
// typing, which is the case that has to stay fast. "Pay a different amount"
// opens the figure for editing, for a partial payment or for paying ahead into
// credit (PAY-05) -- both of which the ledger has always accepted, and which
// previously meant leaving the dashboard for the tab page.
templ SettleConfirm(p Page, c TabCard) {
	<div class={ "card", "tabcard", "confirming" }>
		<div class="rowbetween">
			<h2>{ c.Tab.Name }</h2>
			<span class={ "amount", balanceClass(c.Balance) }>{ c.Balance.Display() }</span>
		</div>
		if c.Error != "" {
			<p class="confirmerr">{ c.Error }</p>
		}
		<form
			class="confirmform"
			hx-post={ settlePath(c.Tab.ID) }
			hx-target={ "#" + cardID(c.Tab.ID) }
			hx-swap="innerHTML"
		>
			<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
			<input type="hidden" name="idempotency_key" value={ c.IdempotencyKey }/>
			if c.Custom {
				<label class="methodrow">
					How much?
					<input
						type="text"
						name="amount"
						inputmode="decimal"
						required
						autofocus
						value={ prefill(c.SettleAmount) }
						placeholder="0.00"
						aria-label="Payment amount"
					/>
				</label>
				<p class="muted small">
					{ balanceLabel(c.Balance) }. Anything beyond that becomes a credit against the next charge.
				</p>
			} else {
				<input type="hidden" name="amount" value={ c.SettleAmount.String() }/>
				<p class="confirmq">
					Record a payment of <strong>{ c.SettleAmount.Display() }</strong>?
				</p>
			}
			<label class="methodrow">
				How was it paid?
				<select name="method">
					for _, m := range store.PaymentMethods() {
						<option value={ string(m) }>{ m.Label() }</option>
					}
				</select>
			</label>
			<label class="methodrow">
				Note (optional)
				<input type="text" name="memo" placeholder="What was this for?" aria-label="Payment note"/>
			</label>
			<div class="confirmbtns">
				<button
					type="button"
					class="ghost"
					hx-get={ cardPath(c.Tab.ID) }
					hx-target={ "#" + cardID(c.Tab.ID) }
					hx-swap="innerHTML"
				>Cancel</button>
				if !c.Custom {
					<button
						type="button"
						class="ghost"
						hx-get={ settleCustomPath(c.Tab.ID) }
						hx-target={ "#" + cardID(c.Tab.ID) }
						hx-swap="innerHTML"
					>Different amount</button>
				}
				<button class="primary" type="submit">
					if c.Custom {
						Record payment
					} else {
						Confirm payment
					}
				</button>
			</div>
		</form>
	</div>
}

// NewTab is the tab creation form (TAB-01, TAB-04).
templ NewTab(p Page) {
	@Layout(p) {
		<section class="card narrow">
			<h1>New tab</h1>
			<form method="post" action="/tabs" class="stack">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<label>
					Name
					<input type="text" name="name" required autofocus placeholder="Family phone plan"/>
				</label>
				<label>
					What this covers
					<input type="text" name="description" placeholder="Optional"/>
				</label>
				<label>
					Kind
					<select name="kind">
						for _, k := range store.TabKinds() {
							<option value={ string(k) }>{ k.Label() } &mdash; { k.Describe() }</option>
						}
					</select>
				</label>
				<label>
					Loan amount (Payoff tabs only)
					<input type="text" name="loan_amount" inputmode="decimal" placeholder="Leave blank for a Services tab"/>
				</label>
				<label>
					Annual interest rate % (Payoff tabs only)
					<input type="text" name="interest_apr" inputmode="decimal" placeholder="0 for an interest-free loan"/>
				</label>
				<label>
					Number of payments (Payoff tabs only)
					<input type="number" name="loan_term" min="0" max={ strconv.Itoa(schedule.MaxPeriods) } placeholder="e.g. 48 &mdash; blank for open-ended"/>
				</label>
				<label>
					Scheduled payment (Payoff tabs only)
					<input type="text" name="loan_payment" inputmode="decimal" placeholder="What the lender charges each period"/>
				</label>
				<p class="muted small">
					On a Payoff tab, the loan amount posts once as the opening balance and the scheduled payment is what
					the Payee is expected to pay each period &mdash; two different figures. Enter the payment your lender
					actually charges; once the tab exists it will show the payment its own arithmetic works out, so any
					disagreement is visible. Leave it blank for an open-ended IOU. Line items below are for Services tabs.
				</p>
				<fieldset class="stack">
					<legend>Line items</legend>
					<p class="muted small">
						Items break down what a charge covers so both people can see which line moved when a cost changes.
						They do not carry balances of their own.
					</p>
					for i := 0; i < 3; i++ {
						<div class="itemrow">
							<input type="text" name="item_name" placeholder={ itemPlaceholder(i) }/>
							<input type="text" name="item_amount" inputmode="decimal" placeholder="0.00"/>
						</div>
					}
				</fieldset>
				@ScheduleFields(schedule.Schedule{})
				@FeeFields(fee.Policy{})
				<button class="primary" type="submit">Create tab</button>
			</form>
		</section>
	}
}

// ScheduleFields is the recurrence control, shared by the create form and the
// tab page so both offer exactly the same choices (SCHED-01).
//
// The empty recurrence is a real option and is listed first: a tab billed
// entirely by hand stays legitimate, and clearing a schedule uses this same
// control rather than a separate "remove" action.
templ ScheduleFields(current schedule.Schedule) {
	<fieldset class="stack">
		<legend>Schedule</legend>
		<label>
			Charge this tab
			<select name="schedule_kind">
				<option value="" selected?={ !current.Set() }>Only when I post a charge by hand</option>
				for _, k := range schedule.Kinds() {
					<option value={ string(k) } selected?={ current.Kind == k }>{ kindLabel(k) }</option>
				}
			</select>
		</label>
		<label>
			Repeat every
			<span class="inline-field">
				<input
					type="number"
					name="schedule_interval"
					min="1"
					max={ strconv.Itoa(schedule.MaxInterval) }
					value={ strconv.Itoa(current.Every()) }
					class="narrow-number"
				/>
				<span class="unit">{ intervalUnitLabel(current) }</span>
			</span>
		</label>
		<label>
			Starting on
			<input
				type="date"
				name="schedule_anchor"
				value={ anchorValue(current) }
			/>
		</label>
		<label>
			The charge lands
			<select name="schedule_billing">
				for _, b := range schedule.Billings() {
					<option value={ string(b) } selected?={ current.Billing == b }>{ b.Label() }</option>
				}
			</select>
		</label>
		<p class="muted small">
			Repeat every 1 is every week or every month; 3 is every third. Periods post when someone opens the tab,
			so a tab left alone catches up the moment it is looked at.
			A start date on the 29th, 30th, or 31st lands on the last day of any month that is shorter, and returns to
			the chosen day afterward.
		</p>
	</fieldset>
}

// ProgressBar renders a Payoff tab's repayment progress (PAYOFF-01). The width
// is a whole-number percent, so no client-side computation is needed and the
// bar means exactly what the number beside it says.
// The width is a class rounded to the nearest 5% rather than an inline style,
// because the content-security policy forbids inline styles. The stylesheet
// carries the 21 width steps.
templ ProgressBar(p ledger.Payoff) {
	<div class="progress" role="progressbar" aria-valuenow={ strconv.Itoa(p.ProgressPercent) } aria-valuemin="0" aria-valuemax="100">
		<div class={ "progressfill", payoffStatusClass(p.Status), progressWidthClass(p.ProgressPercent) }></div>
	</div>
}

// FeeFields is the late-fee control, shared by the create form and the tab page
// (FEE-01, FEE-02, FEE-06). "No late fee" is a real option and is listed first.
templ FeeFields(current fee.Policy) {
	<fieldset class="stack">
		<legend>Late fee</legend>
		<label>
			When a payment is late
			<select name="fee_kind">
				<option value="" selected?={ !current.Set() }>Charge no late fee</option>
				<option value="fixed" selected?={ current.Kind == fee.Fixed }>A fixed amount</option>
				<option value="percent" selected?={ current.Kind == fee.Percent }>A percentage of the overdue amount</option>
			</select>
		</label>
		<div class="feerow">
			<label>
				Fixed amount
				<input type="text" name="fee_fixed" inputmode="decimal" placeholder="0.00" value={ fixedValue(current) }/>
			</label>
			<label>
				Percentage
				<input type="text" name="fee_percent" inputmode="decimal" placeholder="0" value={ percentValue(current) }/>
			</label>
		</div>
		<div class="feerow">
			<label>
				Grace period (days)
				<input type="number" name="fee_grace_days" min="0" max="365" value={ graceValue(current) }/>
			</label>
			<label>
				Cap on total fees (optional)
				<input type="text" name="fee_cap" inputmode="decimal" placeholder="No cap" value={ capValue(current) }/>
			</label>
		</div>
		<p class="muted small">
			A fee is assessed once per missed period, after its grace period passes. A percentage is taken on that
			period's own charge, never on a balance that already includes fees, so fees never compound.
		</p>
	</fieldset>
}

// HistoryRow pairs an entry with what the viewer may do to it.
type HistoryRow struct {
	Entry   store.Entry
	Actor   string
	CanUndo bool
}

// TabDetailData is everything the tab page renders.
type TabDetailData struct {
	Tab            store.Tab
	Items          []store.TabItem
	ItemTotal      money.Cents
	Balance        money.Cents
	Rows           []HistoryRow
	Participants   []store.Participant
	Attachable     []store.User
	Role           store.Role
	IdempotencyKey string
	SettleAmount   money.Cents
	// Statements is the per-period view, newest first (CHG-04).
	Statements []ledger.Statement
	// Scheduled reports whether the tab bills itself, and NextDue when the next
	// charge lands (SCHED-05).
	Scheduled bool
	NextDue   schedule.Date
	// JustPosted counts the cycles this render brought current (SCHED-03).
	JustPosted int
	// JustFined counts the late fees this render assessed (FEE-03).
	JustFined int
	// JustInterest counts the interest charges this render accrued.
	JustInterest int
	// Payoff carries loan progress on a Payoff tab, nil on a Services tab.
	Payoff *ledger.Payoff
	// Plan is what the loan's own arithmetic suggests, and how the payment
	// actually being made compares. Advisory: it posts nothing, and the
	// Provider's entered payment stays authoritative.
	Plan ledger.Plan
	// Upcoming is the next scheduled payment or charge, when it falls within
	// the notice window.
	Upcoming Upcoming
	// Today is the current date in the instance timezone.
	Today schedule.Date
	// CanManage covers the tab's own settings: name, kind, schedule, items,
	// and people. Its Provider may, and so may a global administrator.
	CanManage bool
	// CanTransact covers moving money, which is membership only.
	CanTransact bool
	// AsAdmin reports that the viewer is here on the administrator role rather
	// than as a participant, which the page says out loud.
	AsAdmin bool
}

// IsProvider reports whether the viewer bills on this tab.
func (d TabDetailData) IsProvider() bool { return d.Role == store.RoleProvider }

// Archived reports whether the tab has been retired from the active list.
func (d TabDetailData) Archived() bool { return d.Tab.ArchivedAt != nil }

// IsPayoff reports whether this is a Payoff tab.
func (d TabDetailData) IsPayoff() bool { return d.Payoff != nil }

// Upcoming is the next scheduled event on a tab, surfaced ahead of time so a
// payment request appears before it is due. It is empty outside the window.
type Upcoming struct {
	Due       schedule.Date
	Amount    money.Cents
	DaysUntil int
	// IsPayment distinguishes a Payoff tab's expected payment from a Services
	// tab's upcoming charge.
	IsPayment bool
}

// Show reports whether there is an upcoming event to announce.
func (u Upcoming) Show() bool { return !u.Due.IsZero() }

// When renders how soon the event falls, in words.
func (u Upcoming) When() string {
	switch {
	case u.DaysUntil <= 0:
		return "today"
	case u.DaysUntil == 1:
		return "tomorrow"
	default:
		return fmt.Sprintf("in %d days", u.DaysUntil)
	}
}

// TabDetail shows a tab, its people, its derived balance, and its history.
templ TabDetail(p Page, d TabDetailData) {
	@Layout(p) {
		if d.AsAdmin {
			<p class="banner banner-error">
				You are not on this tab. You are seeing it as an administrator, and that access is logged.
				You can change its settings; recording payments is for the people on it.
			</p>
		}
		if d.Archived() {
			<p class="banner">
				This tab is archived. It has stopped billing and sits below the active ones. Its history is untouched.
			</p>
		}
		<section class={ "card", "tabhero", balanceClass(d.Balance) }>
			<div class="rowbetween">
				<div>
					<h1>{ d.Tab.Name }</h1>
					<p class="kindline">
						<span class={ "pill", "pill-kind-" + string(d.Tab.Kind) }>{ d.Tab.Kind.Label() }</span>
						<span class="muted small">{ d.Tab.Kind.Describe() }</span>
					</p>
					if d.Tab.Description != "" {
						<p class="muted">{ d.Tab.Description }</p>
					}
				</div>
				<div class="balanceblock">
					<span class={ "amount", "big", balanceClass(d.Balance) }>{ d.Balance.Display() }</span>
					<span class="muted small">{ balanceLabel(d.Balance) }</span>
				</div>
			</div>
			<p class="muted small schedline">
				{ d.Tab.Schedule.Describe() }
				if d.Scheduled && !d.IsPayoff() {
					&middot; next charge { d.NextDue.Display() }
				}
				&middot; { d.Tab.Fee.Describe() }
			</p>
			if d.JustPosted > 0 {
				<p class="small posted">{ postedNote(d.JustPosted) }</p>
			}
			if d.JustFined > 0 {
				<p class="small posted">{ finedNote(d.JustFined) }</p>
			}
			if d.JustInterest > 0 {
				<p class="small posted">{ interestNote(d.JustInterest) }</p>
			}
		</section>
		if d.IsPayoff() {
			<section class="card">
				<h2>Loan progress</h2>
				if d.Payoff.Principal <= 0 {
					<p class="banner banner-error">
						This loan has no amount yet, so progress cannot be tracked. Post the loan amount as a charge
						(Post a charge, below) -- that is the opening balance the payments draw down.
					</p>
				} else {
				<div class="rowbetween payoffhead">
					<div>
						<span class="amount big owed">{ d.Payoff.Remaining.Display() }</span>
						<span class="muted small">still owed of { d.Payoff.Principal.Display() }</span>
					</div>
					<span class={ "pill", "status", payoffStatusClass(d.Payoff.Status) }>{ d.Payoff.Status.Label() }</span>
				</div>
				@ProgressBar(*d.Payoff)
				<p class="muted small">
					{ d.Payoff.Paid.Display() } paid &middot; { strconv.Itoa(d.Payoff.ProgressPercent) }% of the loan
					if d.Payoff.Interest > 0 {
						&middot; { d.Payoff.Interest.Display() } interest so far
					}
					if d.Payoff.Behind > 0 {
						&middot; <span class="owed">{ d.Payoff.Behind.Display() } behind schedule</span>
					}
					if d.Payoff.Fees > 0 {
						&middot; { d.Payoff.Fees.Display() } in late fees
					}
				</p>
				if d.Tab.Interest() {
					<p class="muted small">
						{ fee.PercentString(d.Tab.InterestAPRBp) } annual interest, on the outstanding principal.
						Interest left unpaid is owed and is repaid first, but does not itself accrue.
					</p>
				}
				if d.Payoff.TermPeriods > 0 {
					<p class="muted small">
						Payment { strconv.Itoa(d.Payoff.PeriodsElapsed) } of { strconv.Itoa(d.Payoff.TermPeriods) }
						if !d.Payoff.Maturity.IsZero() {
							&middot; scheduled to finish { d.Payoff.Maturity.Display() }
						}
						if d.Payoff.Installment > 0 {
							&middot; { d.Payoff.Installment.Display() } expected each period
						}
					</p>
				} else if d.Payoff.Installment > 0 {
					<p class="muted small">
						{ d.Payoff.Installment.Display() } expected each period &middot; open-ended, with no agreed number of payments.
					</p>
				}
				// The true-up. The Provider's payment is the lender's figure and
				// stays authoritative; this only reports what it implies.
				if d.Plan.Drifting() {
					<p class={ "banner", driftBannerClass(d.Plan) }>
						if d.Plan.TrueUp.Behind() {
							At { d.Payoff.Installment.Display() } a period this loan does not finish on time.
							{ driftProjection(d.Plan) }
							Paying <strong>{ d.Plan.TrueUp.Suggested.Display() }</strong> would clear it in the
							{ strconv.Itoa(d.Plan.TrueUp.Remaining) } payments that remain.
						} else {
							At { d.Payoff.Installment.Display() } a period this loan finishes ahead of its term.
							{ driftProjection(d.Plan) }
							{ d.Plan.TrueUp.Suggested.Display() } a period would land it exactly on the
							{ strconv.Itoa(d.Plan.TrueUp.Remaining) } payments that remain.
						}
					</p>
				}
				}
			</section>
		}
		if d.Upcoming.Show() {
			<section class="card upcomingcard">
				if d.Upcoming.IsPayment {
					<h2>Payment coming up</h2>
					<p>
						A payment of <strong>{ d.Upcoming.Amount.Display() }</strong> is expected
						<strong>{ d.Upcoming.When() }</strong>, on { d.Upcoming.Due.Display() }.
					</p>
				} else {
					<h2>Charge coming up</h2>
					<p>
						A charge of <strong>{ d.Upcoming.Amount.Display() }</strong> is scheduled
						<strong>{ d.Upcoming.When() }</strong>, on { d.Upcoming.Due.Display() }.
					</p>
				}
			</section>
		}
		// Operational: the day-to-day actions and views, expanded by default.
		<details class="group" open>
			<summary class="grouphead">Day to day</summary>
			<div class="groupbody">
				if d.CanTransact {
					<section class="card">
						<h2>Record a payment</h2>
						if d.SettleAmount > 0 {
							<p class="muted small">
								if d.IsProvider() {
									Recording on the payee's behalf. The entry is attributed to you.
								} else {
									Money moves outside BitTabby -- this records that it happened.
								}
							</p>
						} else {
							<p class="muted small">Nothing is owed right now. A payment recorded anyway becomes a credit against future charges.</p>
						}
						<form method="post" action={ paymentAction(d.Tab.ID) } class="inlineform">
							<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
							<input type="hidden" name="idempotency_key" value={ d.IdempotencyKey }/>
							<input
								type="text"
								name="amount"
								inputmode="decimal"
								required
								placeholder="0.00"
								value={ prefill(d.SettleAmount) }
								aria-label="Payment amount"
							/>
							<select name="method" aria-label="Payment method">
								for _, m := range store.PaymentMethods() {
									<option value={ string(m) }>{ m.Label() }</option>
								}
							</select>
							<input type="text" name="memo" placeholder="Note (optional)" aria-label="Note"/>
							<button class="primary" type="submit">Record payment</button>
						</form>
					</section>
				}
				if d.IsProvider() {
					<section class="card">
						<h2>Post a charge</h2>
						<form method="post" action={ chargeAction(d.Tab.ID) } class="inlineform">
							<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
							<input type="hidden" name="idempotency_key" value={ chargeKey(d.IdempotencyKey) }/>
							<input type="text" name="amount" inputmode="decimal" required placeholder="0.00" value={ prefill(d.ItemTotal) } aria-label="Charge amount"/>
							<input type="text" name="memo" placeholder="What for?" aria-label="Memo"/>
							<button class="primary" type="submit">Post charge</button>
						</form>
						<p class="muted small">
							A one-off charge, on top of whatever the schedule posts.
						</p>
					</section>
					<section class="card">
						<h2>Adjust what is owed</h2>
						<p class="muted small">
							A correction, not a payment. Use this after a reconciliation, when the balance itself is
							wrong &mdash; recording a payment that never happened would say money changed hands, and on
							a loan it would go to interest before principal.
						</p>
						<form method="post" action={ adjustmentAction(d.Tab.ID) } class="inlineform">
							<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
							<input type="hidden" name="idempotency_key" value={ adjustmentKey(d.IdempotencyKey) }/>
							<select name="direction" aria-label="Direction">
								<option value="credit">Reduce what is owed</option>
								<option value="debit">Increase what is owed</option>
							</select>
							<input type="text" name="amount" inputmode="decimal" required placeholder="0.00" aria-label="Adjustment amount"/>
							<input type="text" name="reason" required placeholder="Why? (required)" aria-label="Reason"/>
							<button class="primary" type="submit">Post adjustment</button>
						</form>
						if d.IsPayoff() {
							<p class="muted small">
								On this loan a credit comes off the principal first, so the reduction is permanent and
								every future interest charge is smaller.
							</p>
						}
					</section>
				}
				if len(d.Items) > 0 {
					<section class="card">
						<h2>What this covers</h2>
						<table class="items">
							<tbody>
								for _, it := range d.Items {
									<tr>
										<td>{ it.Name }</td>
										<td class="right">{ it.Amount.Display() }</td>
									</tr>
								}
							</tbody>
							<tfoot>
								<tr>
									<td>Per period</td>
									<td class="right">{ d.ItemTotal.Display() }</td>
								</tr>
							</tfoot>
						</table>
						if d.CanManage {
							<p class="muted small">Edit these under Setup &amp; configuration below.</p>
						}
					</section>
				}
				if len(d.Statements) > 0 {
					<section class="card">
						<h2>Periods</h2>
						<ul class="statements">
							for _, st := range d.Statements {
								<li class={ "statement", statementClass(st) }>
									<div class="rowbetween">
										<div>
											<strong>{ periodRange(st) }</strong>
											<p class="muted small">
												Due { st.Period.DueOn.Display() } &middot; { statementStatus(st) }
											</p>
										</div>
										<span class={ "amount", "owed" }>{ st.Charge.Display() }</span>
									</div>
									if len(st.Items) > 0 {
										<table class="items breakdown">
											<tbody>
												for _, it := range st.Items {
													<tr>
														<td>{ it.Name }</td>
														<td class="right">{ it.Amount.Display() }</td>
													</tr>
												}
											</tbody>
										</table>
									}
								</li>
							}
						</ul>
						<p class="muted small">
							Payments are applied to the oldest open period first. Nothing here is stored -- every figure is
							computed from the ledger entries that produce the balance above.
						</p>
					</section>
				}
				<section class="card">
					<h2>People</h2>
					<ul class="people">
						for _, who := range d.Participants {
							<li>
								<span>{ who.DisplayName }</span>
								<span class={ "pill", "pill-" + string(who.Role) }>{ string(who.Role) }</span>
								if d.CanManage {
									<form method="post" action={ participantRemoveAction(d.Tab.ID, who.UserID) } class="inline pushright">
										<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
										<button class="link" type="submit">Remove</button>
									</form>
								}
							</li>
						}
					</ul>
					if d.CanManage {
						if len(d.Attachable) > 0 {
							<form method="post" action={ participantAction(d.Tab.ID) } class="inlineform">
								<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
								<select name="user_id" aria-label="Person to attach">
									for _, u := range d.Attachable {
										<option value={ strconv.FormatInt(u.ID, 10) }>{ u.DisplayName }</option>
									}
								</select>
								<button type="submit">Attach as payee</button>
							</form>
						} else {
							<p class="muted small">
								Everyone with an account is already on this tab.
								if p.User != nil && p.User.IsAdmin {
									<a href="/admin/users">Add another person</a>.
								}
							</p>
						}
					}
				</section>
				<section class="card">
					<h2>History</h2>
					if len(d.Rows) == 0 {
						<p class="muted">Nothing posted yet.</p>
					} else {
						<table class="entries">
							<thead>
								<tr>
									<th>When</th>
									<th>What</th>
									<th>Who</th>
									<th class="right">Amount</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								for _, row := range d.Rows {
									<tr class={ rowClass(row) }>
										<td class="nowrap">{ row.Entry.EffectiveAt.Format("Jan 2") }</td>
										<td>
											<span class={ "pill", "pill-" + entryKindClass(row.Entry) }>{ entryKindLabel(row.Entry) }</span>
											if row.Entry.Method.Label() != "" {
												<span class="muted small">{ row.Entry.Method.Label() }</span>
											}
											if row.Entry.Memo != "" {
												<span class="memo">{ row.Entry.Memo }</span>
											}
										</td>
										<td class="muted">{ row.Actor }</td>
										<td class={ "right", "amount", amountClass(row.Entry.Amount) }>{ row.Entry.Amount.Display() }</td>
										<td class="right">
											if row.CanUndo && row.Entry.Kind == store.KindFee {
												// Waiving a fee records a reason (FEE-07).
												<form method="post" action={ undoAction(d.Tab.ID, row.Entry.Seq) } class="waiveform">
													<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
													<input type="text" name="reason" placeholder="Reason (optional)" aria-label="Waiver reason"/>
													<button class="link" type="submit">Waive</button>
												</form>
											} else if row.CanUndo {
												<form method="post" action={ undoAction(d.Tab.ID, row.Entry.Seq) } class="inline">
													<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
													<button class="link" type="submit">Undo</button>
												</form>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
						<p class="muted small">
							Entries are never edited or deleted. Undo posts a reversing entry that points at the original, and both stay visible.
						</p>
					}
				</section>
			</div>
		</details>
		// Setup: how the tab is configured. Collapsed by default so a provider is
		// not shown the configuration forms during day-to-day use.
		if d.CanManage {
			<details class="group">
				<summary class="grouphead">Setup &amp; configuration</summary>
				<div class="groupbody">
					<section class="card">
						<h2>Tab details</h2>
						<form method="post" action={ detailsAction(d.Tab.ID) } class="stack">
							<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
							<label>
								Name
								<input type="text" name="name" value={ d.Tab.Name } required maxlength="120"/>
							</label>
							<label>
								What this covers
								<input type="text" name="description" value={ d.Tab.Description } maxlength="500" placeholder="Optional"/>
							</label>
							<label>
								Kind
								<select name="kind">
									for _, k := range store.TabKinds() {
										<option value={ string(k) } selected?={ d.Tab.Kind == k }>
											{ k.Label() } &mdash; { k.Describe() }
										</option>
									}
								</select>
							</label>
							<button class="primary" type="submit">Save details</button>
						</form>
						<p class="muted small">
							Changing the kind changes how the tab is presented and measured, never what it has already charged.
							Every change here is written to the log.
						</p>
						<form method="post" action={ archiveAction(d.Tab.ID) } class="inline archiveform">
							<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
							if d.Archived() {
								<button type="submit">Reactivate this tab</button>
							} else {
								<button type="submit">Archive this tab</button>
							}
						</form>
					</section>
					<section class="card">
						<h2>Schedule</h2>
						if d.IsPayoff() {
							<p class="muted small">On a Payoff tab, the schedule is when payments are expected, not when charges post.</p>
						}
						<form method="post" action={ scheduleAction(d.Tab.ID) } class="stack">
							<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
							@ScheduleFields(d.Tab.Schedule)
							<button class="primary" type="submit">Save schedule</button>
						</form>
					</section>
					<section class="card">
						<h2>Late fee</h2>
						<form method="post" action={ feeAction(d.Tab.ID) } class="stack">
							<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
							@FeeFields(d.Tab.Fee)
							<button class="primary" type="submit">Save late fee</button>
						</form>
					</section>
					if d.IsPayoff() {
						<section class="card">
							<h2>Interest</h2>
							<form method="post" action={ interestAction(d.Tab.ID) } class="inlineform">
								<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
								<label>
									Annual rate %
									<input type="text" name="interest_apr" inputmode="decimal" placeholder="0" value={ interestValue(d.Tab.InterestAPRBp) }/>
								</label>
								<button class="primary" type="submit">Save interest</button>
							</form>
							<p class="muted small">
								Interest accrues each period on the outstanding principal, so it falls as the loan is paid down.
								It is charged on the principal only -- never on late fees, and never on interest that has gone
								unpaid, which is owed and is repaid first but does not itself accrue.
							</p>
						</section>
						<section class="card">
							<h2>Loan term and payment</h2>
							<form method="post" action={ loanAction(d.Tab.ID) } class="stack">
								<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
								<label>
									Number of payments
									<input
										type="number"
										name="loan_term"
										min="0"
										max={ strconv.Itoa(schedule.MaxPeriods) }
										value={ termValue(d.Tab.LoanTermPeriods) }
										placeholder="Blank or 0 for open-ended"
									/>
								</label>
								<label>
									Payment each period
									<input
										type="text"
										name="loan_payment"
										inputmode="decimal"
										value={ paymentValue(d.Tab.LoanPayment) }
										placeholder="What the lender charges"
									/>
								</label>
								<button class="primary" type="submit">Save loan terms</button>
							</form>
							if d.Plan.HasSuggestion {
								<p class="muted small">
									For { d.Payoff.Principal.Display() } over { strconv.Itoa(d.Tab.LoanTermPeriods) } payments
									if d.Tab.Interest() {
										at { fee.PercentString(d.Tab.InterestAPRBp) },
									} else {
										with no interest,
									}
									this works out to <strong>{ d.Plan.Suggested.Display() }</strong> a period,
									with a final payment of { d.Plan.Final.Display() }
									if d.Plan.TotalInterest > 0 {
										and { d.Plan.TotalInterest.Display() } of interest over the life of the loan.
									} else {
										.
									}
								</p>
							}
							<p class="muted small">
								Enter the payment your lender actually charges, even when it differs from the figure above.
								The lender's number is the one that has to be paid; this tab reports the difference rather
								than overriding it. Saving a corrected payment changes what is expected from here on and
								never rewrites interest or fees already charged.
							</p>
						</section>
					}
					if !d.IsPayoff() {
					<section class="card">
						<h2>Line items</h2>
						<p class="muted small">
							A change applies from the next period onward. Periods already posted keep the breakdown they
							captured, so what was billed stays what was billed (CHG-02).
						</p>
						for _, it := range d.Items {
							<div class="itemedit">
								<form method="post" action={ itemAction(d.Tab.ID, it.ID) } class="inlineform">
									<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
									<input type="text" name="name" value={ it.Name } required aria-label="Item name"/>
									<input type="text" name="amount" inputmode="decimal" value={ it.Amount.String() } required aria-label="Item amount"/>
									<button type="submit">Save</button>
								</form>
								<form method="post" action={ itemRemoveAction(d.Tab.ID, it.ID) } class="inline">
									<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
									<button class="link" type="submit">Remove</button>
								</form>
							</div>
						}
						<form method="post" action={ itemsAction(d.Tab.ID) } class="inlineform">
							<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
							<input type="text" name="name" placeholder="Add a line item" required aria-label="New item name"/>
							<input type="text" name="amount" inputmode="decimal" placeholder="0.00" required aria-label="New item amount"/>
							<button type="submit">Add item</button>
						</form>
					</section>
					} else if len(d.Items) > 0 {
						// Items a Payoff tab carried before the payment became a
						// field of its own. They are the Provider's data, so they
						// are shown rather than discarded, but nothing reads them.
						<section class="card">
							<h2>Old line items</h2>
							<p class="muted small">
								This tab was set up when a Payoff tab's expected payment came from its line items. The
								payment is now its own field above, and these are no longer used for anything. They are
								kept here rather than deleted because they are yours.
							</p>
							for _, it := range d.Items {
								<p class="muted small">{ it.Name } &middot; { it.Amount.Display() }</p>
							}
						</section>
					}
				</div>
			</details>
		}
	}
}

// ---------------------------------------------------------------------------
// View helpers
// ---------------------------------------------------------------------------

func cardID(id int64) string { return "tab-" + strconv.FormatInt(id, 10) }

func tabHref(id int64) templ.SafeURL {
	return templ.SafeURL("/tabs/" + strconv.FormatInt(id, 10))
}

func cardPath(id int64) string {
	return "/tabs/" + strconv.FormatInt(id, 10) + "/card"
}

func settleConfirmPath(id int64) string {
	return "/tabs/" + strconv.FormatInt(id, 10) + "/settle"
}

func settlePath(id int64) string {
	return "/tabs/" + strconv.FormatInt(id, 10) + "/settle"
}

// settleCustomPath opens the same confirmation with the amount editable.
func settleCustomPath(id int64) string {
	return "/tabs/" + strconv.FormatInt(id, 10) + "/settle?custom=1"
}

func chargeAction(id int64) templ.SafeURL {
	return templ.SafeURL("/tabs/" + strconv.FormatInt(id, 10) + "/charges")
}

func adjustmentAction(id int64) templ.SafeURL {
	return templ.SafeURL("/tabs/" + strconv.FormatInt(id, 10) + "/adjustments")
}

func paymentAction(id int64) templ.SafeURL {
	return templ.SafeURL("/tabs/" + strconv.FormatInt(id, 10) + "/payments")
}

func participantAction(id int64) templ.SafeURL {
	return templ.SafeURL("/tabs/" + strconv.FormatInt(id, 10) + "/participants")
}

func undoAction(tabID, seq int64) templ.SafeURL {
	return templ.SafeURL("/tabs/" + strconv.FormatInt(tabID, 10) +
		"/entries/" + strconv.FormatInt(seq, 10) + "/undo")
}

func detailsAction(id int64) templ.SafeURL {
	return templ.SafeURL("/tabs/" + strconv.FormatInt(id, 10) + "/details")
}

func archiveAction(id int64) templ.SafeURL {
	return templ.SafeURL("/tabs/" + strconv.FormatInt(id, 10) + "/archive")
}

func participantRemoveAction(tabID, userID int64) templ.SafeURL {
	return templ.SafeURL("/tabs/" + strconv.FormatInt(tabID, 10) +
		"/participants/" + strconv.FormatInt(userID, 10) + "/remove")
}

func scheduleAction(id int64) templ.SafeURL {
	return templ.SafeURL("/tabs/" + strconv.FormatInt(id, 10) + "/schedule")
}

func feeAction(id int64) templ.SafeURL {
	return templ.SafeURL("/tabs/" + strconv.FormatInt(id, 10) + "/fee")
}

func interestAction(id int64) templ.SafeURL {
	return templ.SafeURL("/tabs/" + strconv.FormatInt(id, 10) + "/interest")
}

func loanAction(id int64) templ.SafeURL {
	return templ.SafeURL("/tabs/" + strconv.FormatInt(id, 10) + "/loan")
}

// termValue renders a loan term for the form; blank for an open-ended loan, so
// the placeholder explains what blank means rather than showing a bare 0.
func termValue(periods int) string {
	if periods <= 0 {
		return ""
	}
	return strconv.Itoa(periods)
}

// paymentValue renders a scheduled payment for the form; blank when unset.
func paymentValue(c money.Cents) string {
	if c <= 0 {
		return ""
	}
	return c.String()
}

// interestValue renders an APR in basis points as a percentage for the form,
// without a trailing sign; blank when there is no interest.
func interestValue(bp int64) string {
	if bp <= 0 {
		return ""
	}
	return strings.TrimSuffix(fee.PercentString(bp), "%")
}

func interestNote(n int) string {
	if n == 1 {
		return "1 interest charge was posted just now."
	}
	return fmt.Sprintf("%d interest charges were posted just now.", n)
}

// entryKindLabel and entryKindClass name an entry for the history: interest is
// a charge, but reads and colours as "interest" so it is not confused with the
// loan principal.
func entryKindLabel(e store.Entry) string {
	if e.Category == store.CategoryInterest {
		return "interest"
	}
	// An adjustment reads as what it did, since the direction is the thing a
	// person is trying to work out when scanning history. The sign carries it:
	// positive reduces what is owed.
	if e.Kind == store.KindAdjustment {
		if e.Amount > 0 {
			return "credit"
		}
		return "debit"
	}
	return string(e.Kind)
}

func entryKindClass(e store.Entry) string {
	if e.Category == store.CategoryInterest {
		return "interest"
	}
	if e.Kind == store.KindAdjustment {
		if e.Amount > 0 {
			return "credit"
		}
		return "debit"
	}
	return string(e.Kind)
}

// finedNote explains late fees that posted on load, the fee counterpart to
// postedNote (FEE-03).
func finedNote(n int) string {
	if n == 1 {
		return "1 late fee was assessed just now."
	}
	return fmt.Sprintf("%d late fees were assessed just now.", n)
}

// payoffSummary is the one-line status under a Payoff card's remaining figure.
func payoffSummary(p ledger.Payoff) string {
	if p.Settled() {
		return "Paid off"
	}
	return fmt.Sprintf("%d%% repaid", p.ProgressPercent)
}

func payoffStatusClass(s ledger.PayoffStatus) string {
	switch s {
	case ledger.StatusSettled:
		return "settled"
	case ledger.StatusAhead:
		return "ahead"
	case ledger.StatusOnTrack:
		return "ontrack"
	case ledger.StatusBehind:
		return "behind"
	default:
		return ""
	}
}

// settledClass dims a fully paid Payoff loan on the dashboard, the way an
// archived tab is dimmed (PAYOFF-03).
func settledClass(c TabCard) string {
	if c.Settled() {
		return "settledtab"
	}
	return ""
}

// progressWidthClass rounds a percent to the nearest 5 and names the width
// class the stylesheet carries, avoiding a CSP-forbidden inline style.
func progressWidthClass(pct int) string {
	if pct < 0 {
		pct = 0
	}
	if pct > 100 {
		pct = 100
	}
	rounded := ((pct + 2) / 5) * 5
	return "w-" + strconv.Itoa(rounded)
}

// fixedValue, percentValue, graceValue, and capValue prefill the fee form from
// an existing policy, leaving a field blank where it does not apply.
func fixedValue(p fee.Policy) string {
	if p.Kind == fee.Fixed && p.Fixed > 0 {
		return p.Fixed.String()
	}
	return ""
}

func percentValue(p fee.Policy) string {
	if p.Kind != fee.Percent || p.PercentBP <= 0 {
		return ""
	}
	// PercentString renders "5%" or "2.5%"; the form field wants it without the
	// trailing sign.
	return strings.TrimSuffix(fee.PercentString(p.PercentBP), "%")
}

func graceValue(p fee.Policy) string {
	if !p.Set() {
		return "0"
	}
	return strconv.Itoa(p.GraceDays)
}

func capValue(p fee.Policy) string {
	if p.Set() && p.Cap > 0 {
		return p.Cap.String()
	}
	return ""
}

func itemsAction(id int64) templ.SafeURL {
	return templ.SafeURL("/tabs/" + strconv.FormatInt(id, 10) + "/items")
}

func itemAction(tabID, itemID int64) templ.SafeURL {
	return templ.SafeURL("/tabs/" + strconv.FormatInt(tabID, 10) +
		"/items/" + strconv.FormatInt(itemID, 10))
}

func itemRemoveAction(tabID, itemID int64) templ.SafeURL {
	return templ.SafeURL("/tabs/" + strconv.FormatInt(tabID, 10) +
		"/items/" + strconv.FormatInt(itemID, 10) + "/remove")
}

// kindLabel names a recurrence in the words the form asks its question in.
// The count beside it in the form supplies "how many", so these name the unit.
func kindLabel(k schedule.Kind) string {
	switch k {
	case schedule.Weekly:
		return "Weeks"
	case schedule.MonthlyDay:
		return "Months, on the start date's day"
	case schedule.MonthlyLast:
		return "Months, on the last day"
	default:
		return string(k)
	}
}

// intervalUnitLabel names what the interval counts, for the text beside the
// number input. An unscheduled tab has no unit yet, so it reads generically.
func intervalUnitLabel(s schedule.Schedule) string {
	if u := s.Kind.Unit().Label(); u != "" {
		return u
	}
	return "periods"
}

// driftBannerClass colours the true-up notice. Falling short of the term is a
// warning; finishing early is merely information.
func driftBannerClass(p ledger.Plan) string {
	if p.TrueUp.Behind() {
		return "banner-warn"
	}
	return "banner-info"
}

// driftProjection states what the current payment actually does, in the one
// sentence a person needs: when it finishes, or that it never does.
func driftProjection(p ledger.Plan) string {
	o := p.TrueUp.Projected
	if !o.Retires {
		return "At that rate the balance never clears, because the payment does not cover the interest."
	}
	return "It would take " + strconv.Itoa(o.Periods) + " more payments rather than " +
		strconv.Itoa(p.TrueUp.Remaining) + "."
}

// anchorValue fills the date input. A tab with no schedule yet leaves it blank
// rather than proposing a date the Provider did not choose.
func anchorValue(s schedule.Schedule) string {
	if s.Anchor.IsZero() {
		return ""
	}
	return s.Anchor.String()
}

// postedNote explains a balance that moved on load, since a charge appearing
// without anyone posting one is otherwise startling (SCHED-03).
func postedNote(n int) string {
	if n == 1 {
		return "1 period came due and was posted just now."
	}
	return fmt.Sprintf("%d periods came due and were posted just now.", n)
}

// periodRange names the days a cycle covers. End is exclusive, so the label
// names the last day actually inside it.
func periodRange(st ledger.Statement) string {
	return st.Period.Start.Display() + " to " + st.Period.End.AddDays(-1).Display()
}

func statementStatus(st ledger.Statement) string {
	switch {
	case st.Reversed:
		return "undone"
	case st.Settled():
		return "paid"
	case st.Overdue:
		return fmt.Sprintf("%s overdue", st.Outstanding().Display())
	case st.Paid > 0:
		return fmt.Sprintf("%s of %s paid", st.Paid.Display(), st.Charge.Display())
	default:
		return fmt.Sprintf("%s outstanding", st.Outstanding().Display())
	}
}

func statementClass(st ledger.Statement) string {
	switch {
	case st.Reversed:
		return "reversal"
	case st.Settled():
		return "settled"
	case st.Overdue:
		return "overdue"
	default:
		return "owed"
	}
}

// archivedClass dims a retired tab on the dashboard. It still holds a real
// balance and a real history, so it recedes rather than disappearing.
func archivedClass(t store.Tab) string {
	if t.ArchivedAt != nil {
		return "archived"
	}
	return ""
}

// balanceClass colors by direction. Negative means the Payee owes (TAB-06).
func balanceClass(c money.Cents) string {
	switch {
	case c < 0:
		return "owed"
	case c > 0:
		return "credit"
	default:
		return "settled"
	}
}

func amountClass(c money.Cents) string {
	if c < 0 {
		return "owed"
	}
	return "credit"
}

func balanceLabel(c money.Cents) string {
	switch {
	case c < 0:
		return fmt.Sprintf("%s owed", c.Neg().Display())
	case c > 0:
		return fmt.Sprintf("%s in credit", c.Display())
	default:
		return "Settled up"
	}
}

func rowClass(row HistoryRow) string {
	if row.Entry.Kind == store.KindReversal {
		return "reversal"
	}
	if !row.CanUndo && row.Entry.Kind != store.KindReversal {
		return "reversed"
	}
	return ""
}

func itemPlaceholder(i int) string {
	switch i {
	case 0:
		return "Line 1 (e.g. Phone line)"
	case 1:
		return "Line 2"
	default:
		return "Line 3"
	}
}

// prefill renders an amount for a form field, leaving it blank at zero so the
// user is not asked to clear a "0.00" before typing.
func prefill(amount money.Cents) string {
	if amount <= 0 {
		return ""
	}
	return amount.String()
}

// chargeKey derives a distinct key for the charge form on a page that also
// carries a payment form, so the two cannot collide on one idempotency key.
func chargeKey(base string) string { return base + "-charge" }

// adjustmentKey derives the adjustment form's idempotency key from the page's,
// so a double-tapped correction posts once (LEDGER-07).
func adjustmentKey(base string) string { return base + "-adjustment" }
